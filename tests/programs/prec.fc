;; FunC precedence: & is like *, | is like +, unary - is below *
int main() {
    ~dump(1 < 2 * 3);       ;; 1 < 6
    ~dump(- 2 * 3 + 10);    ;; -(2 * 3) + 10
    ~dump(6 & 3 | 8);       ;; (6 & 3) | 8
    ~dump(1 + 6 & 3);       ;; 1 + (6 & 3)
    ~dump(~ 0 * 5);         ;; (~ 0) * 5
    ~dump(10 - 3 - 2);
    return 100 / 10 / 5;
}
