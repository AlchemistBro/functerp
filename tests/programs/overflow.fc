;; int is 257-bit signed: -2^256 .. 2^256 - 1
int main() {
    int x = 1;
    repeat (255) { x *= 2; }
    ~dump(- x - x);     ;; -2^256 still fits (- x * 2 would overflow first)
    x *= 2;            ;; 2^256 does not
    return x;
}
