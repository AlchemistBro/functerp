int is_odd(int n);

int is_even(int n) {
    if (n == 0) { return -1; }
    return is_odd(n - 1);
}

int is_odd(int n) {
    if (n == 0) { return 0; }
    return is_even(n - 1);
}

int fib(int n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

(int, int, int) main() {
    return (fib(15), is_even(10), is_odd(10));
}
