;; all FunC divisions: / to -inf, ^/ to +inf, ~/ to nearest
int main() {
    ~dump((7 / 2, (- 7) / 2, 7 ^/ 2, (- 7) ^/ 2, 6 ^/ 5, (- 6) ^/ 5));
    ~dump((3 ~/ 2, (- 3) ~/ 2, 7 ~/ 3, 8 ~/ 3, 3 ~/ -2));
    ~dump((7 % 3, -7 % 3, 7 % -3, 7 ^% 2, 8 ~% 3));
    (int q, int r) = 17 /% 5;
    int x = 100;
    x ~/= 7;
    x %= 5;
    ~dump((q, r, x));
    return 1 % 0;
}
{- out:
#DEBUG#: s0 = (3, -4, 4, -3, 2, -1)
#DEBUG#: s0 = (2, -1, 2, 3, -1)
#DEBUG#: s0 = (1, 2, -2, -1, -1)
#DEBUG#: s0 = (3, 2, 4)
exit code: 4
