#DEBUG#: s0 = -1
#DEBUG#: s0 = 0
#DEBUG#: s0 = 0
#DEBUG#: s0 = -1
#DEBUG#: s0 = -1
#DEBUG#: s0 = 1
#DEBUG#: s0 = 2
result: 0
